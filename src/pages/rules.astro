---
import Layout from '../layouts/Layout.astro';
import PageGuide from '../components/PageGuide.astro';
import Icon from '../components/Icon.astro';
import { query } from '../lib/db';
import { ruleGroups, rulesCheckedOn } from '../data/rules';
import { pageGuides } from '../data/page-guides';
const format = (iso: string, options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { ...options, timeZone: 'UTC' }).format(new Date(iso));
type Update = { title: string; kind: string; reference: string | null; day: string | null; official_url: string; matched_terms: string[]; source: string };
const feeds = [
  { id: 'ombudsman-latest', institution: 'ombudsman', heading: 'Ombudsman decisions & inquiries', summary: 'Decisions, recommendations and inquiries found by daily source checks.', intro: 'Decisions, recommendations and newly opened inquiries on how EU institutions handle harassment, dignity at work and whistleblowing. The Ombudsman does not write staff rules; the office examines whether institutions apply theirs properly.', checked: null as string | null, items: [] as Update[] },
  { id: 'commission-latest', institution: 'commission', heading: 'Commission documents & updates', summary: 'Commission documents and Press Corner updates found by daily checks.', intro: 'Commission documents published in EUR-Lex and items from its Press Corner on harassment, psychosocial risk, whistleblowing, staff inquiries and the rules that give effect to the Staff Regulations.', checked: null as string | null, items: [] as Update[] }
];
let error = '';
try {
  for (const feed of feeds) {
    feed.items = (await query<Update>(`SELECT u.title,u.kind,u.reference,u.document_date::text AS day,u.official_url,u.matched_terms,s.name source FROM institution_updates u JOIN sources s ON s.id=u.source_id WHERE u.institution=$1 ORDER BY u.document_date DESC NULLS LAST,u.id DESC LIMIT 25`, [feed.institution])).rows;
    feed.checked = (await query<{ checked: string | null }>(`SELECT max(last_success_at)::text checked FROM sources WHERE key LIKE $1`, [`${feed.institution}-%`])).rows[0]?.checked ?? null;
  }
} catch (e) { error = e instanceof Error ? e.message : 'Database unavailable'; }
const standing = ruleGroups.reduce((sum, group) => sum + group.rules.length, 0);
const orderedStandingRules = ruleGroups
  .flatMap((group) => group.rules.map((rule) => ({ group, rule })))
  .map((entry, index) => ({ ...entry, index }))
  .sort((a, b) => {
    if (a.rule.date === b.rule.date) return a.index - b.index;
    if (!a.rule.date) return 1;
    if (!b.rule.date) return -1;
    return b.rule.date.localeCompare(a.rule.date);
  });
---
<Layout title="Rules and institutional updates" description="Ombudsman and Commission updates plus hand-maintained references on harassment, dignity and staff well-being, linked to official sources.">
  <div class="page">
    <header class="page-head">
      <div>
        <h1>Rules and institutional updates</h1>
        <p class="lede">What the European Ombudsman and European Commission publish on harassment, dignity and mental health at work, followed by the standing references they work from.</p>
      </div>
    </header>

    <PageGuide {...pageGuides.rules} />

    <nav class="jump" aria-label="On this page">
      {feeds.map((feed) => <a href={`#${feed.id}`}>{feed.heading}</a>)}
      <a href="#standing">Standing rules</a>
    </nav>

    {error && <p class="notice error" role="alert"><Icon name="error" /><span>The latest documents cannot be loaded right now: {error}</span></p>}

    {feeds.map((feed) => (
      <section class="rule-group" id={feed.id} aria-labelledby={`h-${feed.id}`}>
        <details class="rule-group-details">
          <summary class="rule-group-head rule-group-summary">
            <div class="rule-group-summary-main">
              <h2 id={`h-${feed.id}`}>{feed.heading}</h2>
              <p class="rule-group-summary-text">{feed.summary}</p>
            </div>
            <span class="rule-group-toggle" aria-hidden="true"></span>
          </summary>
          <div class="rule-group-content">
            <p class="rule-group-intro">{feed.intro}{feed.checked && <> Last checked <time datetime={feed.checked}>{format(feed.checked, { day: 'numeric', month: 'long', year: 'numeric' })}</time>.</>}</p>
            {feed.items.length === 0 ? (
              <div class="empty"><h3>Nothing collected yet</h3><p>Documents appear here after the next check of the official source.</p></div>
            ) : (
              <ul class="dispatches">
                {feed.items.map((item) => (
                  <li class="dispatch">
                    <p class="dispatch-date">
                      {item.day ? <time datetime={item.day}><span>{format(item.day, { day: 'numeric' })}</span> {format(item.day, { month: 'short', year: 'numeric' })}</time> : <span class="undated">Undated</span>}
                    </p>
                    <div class="dispatch-body">
                      <h3><a href={item.official_url} target="_blank" rel="noreferrer">{item.title}<span class="sr-only"> (opens the official source in a new tab)</span></a></h3>
                      <ul class="tags" aria-label="Matched words">{item.matched_terms.map((term) => <li class="tag">{term}</li>)}</ul>
                    </div>
                    <p class="dispatch-ref"><strong>{item.kind}</strong>{item.reference ?? ''}<span>{item.source}</span><Icon name="external" size={22} /></p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </details>
      </section>
    ))}

    <section class="rule-group" id="standing" aria-labelledby="h-standing">
      <details class="rule-group-details">
        <summary class="rule-group-head rule-group-summary">
          <div class="rule-group-summary-main">
            <h2 id="h-standing">Standing rules</h2>
            <p class="rule-group-summary-text">Hand-maintained reference documents, separate from the daily institution feeds.</p>
          </div>
          <span class="rule-group-toggle" aria-hidden="true"></span>
        </summary>
        <div class="rule-group-content">
          <p class="rule-group-intro">{standing} reference documents, compiled by hand and last checked on <time datetime={rulesCheckedOn}>{format(rulesCheckedOn, { day: 'numeric', month: 'long', year: 'numeric' })}</time>. This part is not updated by the daily check.</p>
          <ul class="dispatches">
            {orderedStandingRules.map(({ group, rule }) => (
              <li class="dispatch">
                <p class="dispatch-date">
                  {rule.date ? <time datetime={rule.date}><span>{format(rule.date, { year: 'numeric' })}</span> {format(rule.date, { day: 'numeric', month: 'short' })}</time> : <span class="undated">Undated</span>}
                </p>
                <div class="dispatch-body">
                  <h3><a href={rule.url} target="_blank" rel="noreferrer">{rule.title}<span class="sr-only"> (opens the official source in a new tab)</span></a></h3>
                  <p class="rule-summary">{rule.summary}</p>
                  <ul class="tags" aria-label="Topics">{rule.topics.map((topic) => <li class="tag">{topic}</li>)}</ul>
                </div>
                <p class="dispatch-ref"><strong>{rule.reference}</strong>{group.body}<span>{rule.kind}</span><Icon name="external" size={22} /></p>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </section>

    <p class="rule-note">The latest documents are found by searching each institution’s official site for a fixed list of words and keeping those whose title contains one. Internal decisions that an institution does not publish there will not appear, and a matching title does not guarantee the document is about staff. Titles are the institutions’ own; the summaries under “Standing rules” are this site’s plain-language descriptions. The linked document is always the authority.</p>
  </div>
</Layout>

<script>
  const openRuleSection = () => {
    const hash = window.location.hash;
    if (!hash) return;
    let id = '';
    try {
      id = decodeURIComponent(hash.slice(1));
    } catch {
      return;
    }
    const target = id ? document.getElementById(id) : null;
    const details = target?.querySelector('details');
    if (details instanceof HTMLDetailsElement) details.open = true;
  };
  openRuleSection();
  window.addEventListener('hashchange', openRuleSection);
</script>
