---
import Layout from '../../layouts/Layout.astro';
import PageGuide from '../../components/PageGuide.astro';
import Icon from '../../components/Icon.astro';
import CaseRow from '../../components/CaseRow.astro';
import { query } from '../../lib/db';
import { pageGuides } from '../../data/page-guides';
const PAGE_SIZE = 20;
let cases: any[] = [], topics: { slug: string; name_en: string }[] = [], matching = 0, error = '';
const url = Astro.url;
const q = url.searchParams.get('q')?.trim() ?? '';
const topic = url.searchParams.get('topic')?.trim() ?? '';
const court = url.searchParams.get('court')?.trim() ?? '';
const sort = ['publication','judgment','name'].includes(url.searchParams.get('sort') ?? '') ? url.searchParams.get('sort')! : 'judgment';
const pageInput = Number(url.searchParams.get('page') ?? 1);
const page = Number.isSafeInteger(pageInput) && pageInput > 0 && Number.isSafeInteger((pageInput - 1) * PAGE_SIZE) ? pageInput : 1;
try {
  const params: unknown[] = [];
  const where: string[] = [];
  if (q) { params.push(`%${q}%`); where.push(`(c.title ILIKE $${params.length} OR c.case_number ILIKE $${params.length} OR c.celex ILIKE $${params.length} OR COALESCE(c.summary,'') ILIKE $${params.length} OR EXISTS (SELECT 1 FROM documents sd WHERE sd.case_id=c.id AND sd.text_content ILIKE $${params.length}))`); }
  if (topic) { params.push(topic); where.push(`EXISTS (SELECT 1 FROM case_topics ct JOIN topics t ON t.id=ct.topic_id WHERE ct.case_id=c.id AND t.slug=$${params.length})`); }
  if (court) { params.push(`%${court}%`); where.push(`co.name ILIKE $${params.length}`); }
  params.push(PAGE_SIZE, (page - 1) * PAGE_SIZE);
  const order = sort === 'name' ? 'c.title ASC' : sort === 'publication' ? 'c.publication_date DESC NULLS LAST' : 'c.judgment_date DESC NULLS LAST';
  const list = await query(`SELECT c.id,c.celex,c.case_number,c.title,c.judgment_date,c.publication_date,c.language,c.relevance_label,c.summary,co.name court, COALESCE(array_agg(DISTINCT t.name_en) FILTER (WHERE t.id IS NOT NULL),'{}') topics, count(*) OVER() matching FROM cases c LEFT JOIN courts co ON co.id=c.court_id LEFT JOIN case_topics ct ON ct.case_id=c.id LEFT JOIN topics t ON t.id=ct.topic_id ${where.length ? `WHERE ${where.join(' AND ')}` : ''} GROUP BY c.id,co.name ORDER BY ${order},c.id DESC LIMIT $${params.length - 1} OFFSET $${params.length}`, params);
  cases = list.rows;
  matching = Number(cases[0]?.matching ?? 0);
  topics = (await query<{ slug: string; name_en: string }>('SELECT slug,name_en FROM topics WHERE enabled ORDER BY name_en')).rows;
} catch (e) { error = e instanceof Error ? e.message : 'Database unavailable'; }
const filtered = Boolean(q || topic || court);
if (error) { Astro.response.status = 503; Astro.response.headers.set('Retry-After', '60'); }
else if (page > 1 && cases.length === 0) Astro.response.status = 404;
const pageHref = (target: number) => {
  const search = new URLSearchParams();
  if (q) search.set('q', q);
  if (topic) search.set('topic', topic);
  if (court) search.set('court', court);
  if (sort !== 'judgment') search.set('sort', sort);
  if (target > 1) search.set('page', String(target));
  const text = search.toString();
  return text ? `/cases?${text}` : '/cases';
};
const first = (page - 1) * PAGE_SIZE + 1;
const last = first + cases.length - 1;
const hasNext = last < matching;
const topicHref = (slug: string) => {
  const search = new URLSearchParams(url.searchParams);
  search.delete('page');
  if (slug) search.set('topic', slug); else search.delete('topic');
  return `/cases${search.size ? `?${search}` : ''}`;
};
---
<Layout title={`EU court rulings on workplace rights${page > 1 ? ` — page ${page}` : ''}`} description="Search Court of Justice and General Court rulings on harassment, discrimination and psychosocial risks. Find case references and official judgment links." noindex={Boolean(error) || (page > 1 && !cases.length)} canonicalPage={page} pageType="CollectionPage">
  <div class="page">
    <header class="page-head">
      <div>
        <h1>Court rulings</h1>
        <p class="lede">Decisions of the Court of Justice and the General Court on harassment, discrimination and psychosocial risk at work.</p>
      </div>
    </header>

    <PageGuide {...pageGuides.cases} />

    {topics.length > 0 && <nav class="collection-topics" aria-label="Browse rulings by topic">
      <a href={topicHref('')} aria-current={!topic ? 'true' : undefined}>All topics</a>
      {topics.map((item) => <a href={topicHref(item.slug)} aria-current={topic === item.slug ? 'true' : undefined}>{item.name_en}</a>)}
    </nav>}

    <form class="filters" method="get" role="search" aria-label="Search and filter rulings">
      <div class="field search"><label for="f-q">Search</label><input id="f-q" name="q" type="search" value={q} placeholder="Name, case number or words from the ruling" /></div>
      <div class="field"><label for="f-topic">Topic</label><select id="f-topic" name="topic"><option value="">All topics</option>{topics.map((item) => <option value={item.slug} selected={topic === item.slug}>{item.name_en}</option>)}</select></div>
      <div class="field"><label for="f-court">Court</label><input id="f-court" name="court" value={court} placeholder="e.g. General Court" /></div>
      <div class="field"><label for="f-sort">Sort by</label><select id="f-sort" name="sort"><option value="judgment" selected={sort === 'judgment'}>Newest judgment</option><option value="publication" selected={sort === 'publication'}>Newest publication</option><option value="name" selected={sort === 'name'}>Official title</option></select></div>
      <div class="actions"><button class="button" type="submit">Search rulings <Icon name="arrow-right" size={16} /></button>{filtered && <a class="button secondary" href="/cases">Clear</a>}</div>
    </form>

    {error ? (
      <div class="empty" role="alert"><h2>The rulings cannot be loaded right now</h2><p>{error}</p></div>
    ) : cases.length === 0 ? (
      <div class="empty">
        <h2>{page > 1 ? 'No more rulings on this page' : filtered ? 'No rulings match these filters' : 'No rulings collected yet'}</h2>
        <p>{page > 1 ? 'You have gone past the last page of results.' : filtered ? 'Try a broader search term or clear the filters.' : 'Rulings appear here after the first check of the official source.'}</p>
        {page > 1 ? <a class="button secondary" href={pageHref(1)}>Back to first page</a> : filtered ? <a class="button secondary" href="/cases">Clear filters</a> : <a class="button" href="/monitoring">Go to monitoring</a>}
      </div>
    ) : (
      <>
        <p class="result-bar" role="status">Showing {first}–{last} of {matching} {matching === 1 ? 'ruling' : 'rulings'}{filtered ? ' matching your filters' : ''}</p>
        <ul class="dispatches">{cases.map((item) => <CaseRow item={item} />)}</ul>
        <nav class="pagination" aria-label="Pagination">
          <span>Page {page} of {Math.max(1, Math.ceil(matching / PAGE_SIZE))}</span>
          <div>
            {page > 1 ? <a class="button secondary" href={pageHref(page - 1)} rel="prev"><Icon name="arrow-left" size={16} /> Previous</a> : <span class="button secondary" aria-disabled="true"><Icon name="arrow-left" size={16} /> Previous</span>}
            {hasNext ? <a class="button secondary" href={pageHref(page + 1)} rel="next">Next <Icon name="arrow-right" size={16} /></a> : <span class="button secondary" aria-disabled="true">Next <Icon name="arrow-right" size={16} /></span>}
          </div>
        </nav>
      </>
    )}
  </div>
</Layout>
