---
import Layout from '../layouts/Layout.astro';
import PageGuide from '../components/PageGuide.astro';
import OperationsNav from '../components/OperationsNav.astro';
import Icon from '../components/Icon.astro';
import { listProviders } from '../lib/ai';
import { redactError } from '../lib/security';
import { pageGuides } from '../data/page-guides';
let providers: any[] = [], error = '';
try { providers = await listProviders(); } catch (e) { error = redactError(e); }
const names: Record<string, string> = { openai: 'OpenAI / ChatGPT', deepseek: 'DeepSeek', openrouter: 'OpenRouter', anthropic: 'Anthropic Claude' };
---
<Layout title="AI settings for source summaries" description="Optional AI provider settings for source-grounded summaries, with encrypted key storage and connection controls.">
  <div class="page operations-page provider-page">
    <header class="page-head">
      <div>
        <h1>AI settings</h1>
        <p class="lede">Configure an optional provider for source-grounded summaries. Keys are encrypted on the server and never sent back to the browser.</p>
      </div>
    </header>

    <OperationsNav />
    <PageGuide {...pageGuides.settings} />

    <details class="provider-access">
      <summary>Operator access</summary>
      <div class="field provider-token-field"><label for="operator-token">Operator token</label><input id="operator-token" type="password" autocomplete="off" aria-describedby="operator-token-hint" /><span class="hint" id="operator-token-hint">Required to test or save on protected deployments. Kept only while this page is open.</span></div>
    </details>

    <section class="provider-card" aria-labelledby="h-connect">
      <div class="provider-connect">
        <h2 id="h-connect">Connect your AI.</h2>
        <p class="provider-intro">Bring your provider and API key. Choose a model for optional summaries grounded in the official source.</p>
        <form id="provider-form">
          <fieldset id="provider-fields">
            <legend class="sr-only">Provider connection</legend>
            <div class="field"><label for="p-provider">AI provider</label><select id="p-provider" name="provider">{Object.entries(names).map(([value, label]) => <option value={value}>{label}</option>)}</select></div>
            <div class="field"><label for="p-key">API key</label><input id="p-key" name="apiKey" type="password" autocomplete="new-password" spellcheck="false" aria-describedby="p-key-hint" /><span class="hint" id="p-key-hint">Use a provider API key. A ChatGPT or Claude subscription does not include API access.</span></div>
            <div class="field"><label for="p-model">Model identifier</label><input id="p-model" name="model" autocomplete="off" spellcheck="false" aria-describedby="p-model-hint" /><label class="hint" for="model-catalog" id="model-catalog-label" hidden>Available models</label><select id="model-catalog" hidden aria-label="Available models"><option value="">Choose a reported model…</option></select><span class="hint" id="p-model-hint">Test your connection to load models, or enter an identifier.</span></div>
            <details class="provider-advanced"><summary>Advanced endpoint settings</summary><div class="field"><label for="p-url">API endpoint (optional)</label><input id="p-url" name="baseUrl" type="url" placeholder="https://api.openai.com/v1" aria-describedby="p-url-hint" /><span class="hint" id="p-url-hint">Leave blank for the official endpoint.</span></div></details>
            <div class="form-actions">
              <button class="button" id="test-provider" type="button">Test connection <Icon name="arrow-right" /></button>
              <button class="button secondary" type="submit">Save provider</button>
            </div>
          </fieldset>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
      <aside class="provider-includes" aria-label="Connection details">
        <h3>Your connection</h3>
        <ul class="provider-features">
          <li><Icon name="shield" size={23} /><div><strong>Encrypted key storage</strong><p>Saved keys stay on the server.</p></div><Icon name="check" /></li>
          <li><Icon name="activity" size={23} /><div><strong>Test before you save</strong><p>Check API access and discover models.</p></div><Icon name="check" /></li>
          <li><Icon name="scale" size={23} /><div><strong>Official sources first</strong><p>Generated interpretation is labelled separately.</p></div><Icon name="check" /></li>
        </ul>
        <div class="provider-discovery" id="provider-discovery" hidden>
          <h3 id="discovery-title">Available through OpenRouter</h3>
          <p class="hint">OpenRouter’s current provider directory. Availability varies by model; OpenRouter handles routing.</p>
          <div class="field"><label for="provider-search">Find a provider</label><input id="provider-search" type="search" placeholder="Search providers" autocomplete="off" /></div>
          <p class="hint" id="provider-count" role="status"></p>
          <ul id="router-providers" class="router-providers" aria-label="OpenRouter providers"></ul>
        </div>
        <p class="provider-catalog-note" id="catalog-note" role="status">Choose a provider and test your connection to see its model catalogue here.</p>
      </aside>
    </section>

    <section class="panel" aria-labelledby="h-saved">
      <h2 id="h-saved">Saved providers</h2>
      {error ? <p class="notice error" role="alert"><Icon name="error" /><span>{error}</span></p> : providers.length === 0 ? <p class="muted">No provider is configured yet. Every ruling stays readable without AI.</p> : (
        <ul class="provider-list">
          {providers.map((provider) => (
            <li class="provider-row">
              <div class="provider-info">
                <span class="provider-name">{names[provider.provider] ?? provider.provider}<span class:list={['badge', { success: provider.enabled }]}>{provider.enabled ? 'Enabled' : 'Disabled'}</span></span>
                <span class="muted small">{provider.model ?? 'No model selected'} · {provider.hasKey ? 'Key stored (encrypted)' : 'No key stored'}</span>
              </div>
              <div class="provider-actions" data-provider={provider.provider} data-name={names[provider.provider] ?? provider.provider} data-has-key={String(provider.hasKey)} data-model={provider.model ?? ''} data-endpoint={provider.base_url ?? ''}>
                <button class="button secondary" data-action="edit" type="button">Edit</button>
                <button class="button secondary" data-action="test" type="button">Test connection</button>
                <button class="button secondary" data-action="toggle" data-enabled={String(provider.enabled)} type="button">{provider.enabled ? 'Disable' : 'Enable'}</button>
                <button class="button danger" data-action="remove" type="button">Remove</button>
              </div>
              <span class="form-status provider-result" role="status"></span>
            </li>
          ))}
        </ul>
      )}
    </section>

  </div>
</Layout>
<script>
  import '../scripts/providers';
</script>
