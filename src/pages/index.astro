---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CaseRow from '../components/CaseRow.astro';
import { query } from '../lib/db';
import { selectedDecisions, selectedDecisionsCheckedOn, ruleGroups } from '../data/rules';
import { researchTopics } from '../data/research-topics';

let latest: any[] = [], topics: { slug: string; name_en: string }[] = [], total = 0, sourceCount = 0, lastCheck: string | null = null, error = '';
try {
  latest = (await query(`SELECT c.id,c.celex,c.case_number,c.title,c.judgment_date,c.summary,co.name court, COALESCE(array_agg(DISTINCT t.name_en) FILTER (WHERE t.id IS NOT NULL),'{}') topics FROM cases c LEFT JOIN courts co ON co.id=c.court_id LEFT JOIN case_topics ct ON ct.case_id=c.id LEFT JOIN topics t ON t.id=ct.topic_id GROUP BY c.id,co.name ORDER BY c.judgment_date DESC NULLS LAST,c.id DESC LIMIT 5`)).rows;
  total = Number((await query<{ total: string }>('SELECT count(*) total FROM cases')).rows[0].total);
  topics = (await query<{ slug: string; name_en: string }>('SELECT slug,name_en FROM topics WHERE enabled ORDER BY name_en')).rows;
  const sources = (await query<{ enabled: string; checked: string | null }>(`SELECT count(*) FILTER (WHERE enabled) enabled, max(last_checked_at) FILTER (WHERE key='eurlex-sparql') checked FROM sources`)).rows[0];
  sourceCount = Number(sources?.enabled ?? 0);
  lastCheck = sources?.checked ?? null;
} catch (e) { error = e instanceof Error ? e.message : 'Database unavailable'; }

const formatDate = (value: string | Date, options: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' }) => new Intl.DateTimeFormat('en-GB', { ...options, timeZone: 'Europe/Brussels' }).format(new Date(value));
const latestJudgment = latest.find((item) => item.judgment_date)?.judgment_date ?? null;
const standingCount = ruleGroups.reduce((sum, group) => sum + group.rules.length, 0);

const ledger = [
  total > 0 && { label: 'Court rulings on record', value: String(total) },
  latestJudgment && { label: 'Most recent judgment', value: formatDate(latestJudgment) },
  lastCheck && { label: 'Court feed last checked', value: formatDate(lastCheck) },
  sourceCount > 0 && { label: 'Official feeds monitored', value: String(sourceCount) }
].filter(Boolean) as { label: string; value: string }[];
if (error) { Astro.response.status = 503; Astro.response.headers.set('Retry-After', '60'); }

const sections = [
  { href: '/cases', title: 'Court rulings', description: 'Court of Justice and General Court decisions on harassment, psychosocial risk and discrimination at work, searchable by party, case number or topic.', meta: 'Daily source checks · EUR-Lex / Cellar' },
  { href: '/rules', title: 'Rules & updates', description: 'What the European Ombudsman and Commission publish on dignity at work, alongside the staff rules and policies those institutions apply.', meta: `Institution feeds · ${standingCount} standing references` },
  { href: '/decisions', title: 'Selected records', description: 'A short, hand-picked list of judgments, Ombudsman decisions and Commission reports on staff safeguards and OLAF.', meta: `${selectedDecisions.length} records · checked ${formatDate(selectedDecisionsCheckedOn, { day: 'numeric', month: 'short', year: 'numeric' })}` },
  { href: '/discharge', title: 'Budget discharge', description: 'How Parliament scrutinises the way EU institutions spent their budget, what it decided and where the replies are published.', meta: 'Editorial guide · FY2024 cycle' }
];
---

<Layout title="EU employment law: court rulings & workplace rights" description="Find EU court rulings on workplace harassment, discrimination and psychosocial risks. Explore institutional rules and accountability, linked to official sources." noindex={Boolean(error)}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="home-hero-copy">
      <h1 id="home-title">Workplace rights.<br /><span>Straight to the source.</span></h1>
      <p class="home-lede">Follow European court rulings on harassment, discrimination and psychosocial risk at work. Find the record, understand the context, and go straight to the official source.</p>
      <form class="home-search" action="/cases" method="get" role="search" aria-label="Search court rulings">
        <label class="sr-only" for="home-q">Search court rulings</label>
        <input id="home-q" name="q" type="search" placeholder="Party, case number or keyword" autocomplete="off" />
        <button class="button" type="submit">Search rulings <Icon name="arrow-right" size={17} /></button>
      </form>
      {topics.length > 0 && (
        <p class="home-topics">
          <span>Browse by topic</span>
          {topics.map((topic) => <a href={researchTopics.some((item) => item.slug === topic.slug) ? `/topics/${topic.slug}` : `/cases?topic=${encodeURIComponent(topic.slug)}`}>{topic.name_en}</a>)}
        </p>
      )}
    </div>
    <button class="hero-motion" type="button" aria-pressed="false">Pause background animation</button>
    <div class="research-window">
      <div class="research-window-bar"><span class="window-brand">EU JUST / Research desk</span><span>Official sources, connected</span></div>
      <div class="research-window-body">
        <figure class="home-hero-figure">
          <img src="/images/home-hero.png" alt="European Union flag hanging inside a glass and steel atrium." width="1011" height="673" fetchpriority="high" />
        </figure>
        <div class="source-path">
          <h2>A clearer path<br />through the record.</h2>
          <p>From the court's decision to the rules and oversight around it. Follow the source at every step.</p>
          <a href="/cases"><span class="path-node"><Icon name="search" size={18} /></span><span><strong>Find the ruling</strong><small>Court of Justice & General Court</small></span><Icon name="arrow-right" size={18} /></a>
          <a href="/rules"><span class="path-node"><Icon name="external" size={18} /></span><span><strong>Read the rules</strong><small>EU institutions & staff safeguards</small></span><Icon name="arrow-right" size={18} /></a>
          <a href="/discharge"><span class="path-node"><Icon name="arrow-right" size={18} /></span><span><strong>Follow the accountability</strong><small>Parliament's budget discharge</small></span><Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  {ledger.length > 0 && (
    <div class="wrap">
      <dl class="ledger" aria-label="Collection at a glance">
        {ledger.map((cell) => <div><dt>{cell.label}</dt><dd>{cell.value}</dd></div>)}
      </dl>
    </div>
  )}

  <section class="wrap home-services" aria-labelledby="services-title">
    <h2 id="services-title">Four ways to explore the record.</h2>
    <div class="service-grid">
      {[
        { href: '/cases', title: 'Court rulings', icon: 'search', description: 'Find European court decisions on rights at work, with the official source close at hand.', features: ['Search by party, case or keyword', 'Filter by court and matched topic', 'Open the official judgment'], action: 'Find a ruling' },
        { href: '/rules', title: 'Rules & updates', icon: 'scale', description: 'Explore the commitments and policies that shape working life in EU institutions.', features: ['Standing institutional references', 'Ombudsman and Commission updates', 'Official policies and source links'], action: 'Explore the rules' },
        { href: '/decisions', title: 'Selected records', icon: 'book', description: 'Read a focused editorial selection of judgments, reports and oversight records.', features: ['Hand-picked source records', 'Workplace rights and oversight', 'Clear dates and official references'], action: 'Browse the selection' },
        { href: '/discharge', title: 'Budget discharge', icon: 'activity', description: 'Follow how Parliament scrutinises spending and holds EU institutions to account.', features: ['Institution outcomes and decisions', 'Previous-cycle replies', 'Guide to the discharge procedure'], action: 'Follow the accountability' }
      ].map((service) => (
        <a class="service-card" href={service.href}>
          <Icon name={service.icon} size={28} />
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>{service.features.map((feature) => <li><Icon name="tick" size={16} /><span>{feature}</span></li>)}</ul>
          <span class="service-card-action">{service.action}<Icon name="arrow-right" size={17} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap home-latest latest" id="latest" aria-labelledby="home-latest-title">
    <header class="section-head">
      <div>
        <h2 id="home-latest-title">The latest from the courts.</h2><p>Newest first, by judgment date. Each record links to its official source.</p>
      </div>
      {!error && total > 0 && <a class="text-link" href="/cases">All {total} rulings <Icon name="arrow-right" size={18} /></a>}
    </header>
    {error ? (
      <div class="empty" role="alert"><h3>The rulings cannot be loaded right now</h3><p>{error}</p></div>
    ) : latest.length === 0 ? (
      <div class="empty"><h3>No rulings collected yet</h3><p>Rulings appear here after the first check of the official source.</p><a class="button" href="/monitoring">Go to monitoring</a></div>
    ) : (
      <>
        <ul class="dispatches">{latest.map((item, index) => <CaseRow item={item} lead={index === 0} />)}</ul>
        <a class="view-all" href="/cases"><span>Search and filter all {total} rulings</span> <Icon name="arrow-right" size={24} /></a>
      </>
    )}
  </section>

  <section class="home-index" aria-labelledby="home-index-title">
    <div class="wrap home-index-inner">
      <header class="home-index-head">
        <h2 id="home-index-title">See the ruling.<br />Explore the bigger picture.</h2>
        <p>Rulings show how the law was applied. The rules show what institutions committed to. Discharge shows how Parliament holds them to account.</p>
      </header>
      <ul class="index-list">
        {sections.map((section) => (
          <li>
            <a href={section.href}>
              <span class="index-title">{section.title}</span>
              <span class="index-desc">{section.description}</span>
              <span class="index-meta">{section.meta}</span>
              <Icon name="arrow-right" size={22} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap home-method" aria-labelledby="home-method-title">
    <header class="section-head">
      <div>
        <h2 id="home-method-title">An informed reading starts here.</h2>
      </div>
    </header>
    <dl class="method-grid">
      <div>
        <dt>The official text is the authority</dt>
        <dd>Case records link to EUR-Lex. Other items link to the institution that published them. Titles are shown as published.</dd>
      </div>
      <div>
        <dt>Summaries are labelled</dt>
        <dd>AI summaries are optional, marked as generated and kept apart from the official record. They are a reading aid, never a court finding.</dd>
      </div>
      <div>
        <dt>The collection has limits</dt>
        <dd>Rulings are found by keyword searches over a bounded window, and topics are keyword matches rather than legal analysis. Relevant material may be missing.</dd>
      </div>
    </dl>
  </section>
</Layout>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const motionButton = document.querySelector<HTMLButtonElement>('.hero-motion');
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  const setMotion = (paused: boolean) => {
    if (hero) hero.dataset.motion = paused ? 'paused' : 'playing';
    motionButton?.setAttribute('aria-pressed', String(paused));
    if (motionButton) motionButton.textContent = paused ? 'Play background animation' : 'Pause background animation';
  };
  setMotion(motionPreference.matches);
  motionPreference.addEventListener('change', () => setMotion(motionPreference.matches));
  let inView = true;
  const updateVisibility = () => { if (hero) hero.dataset.visibility = document.hidden || !inView ? 'hidden' : 'visible'; };
  if (hero) {
    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; updateVisibility(); }).observe(hero);
    document.addEventListener('visibilitychange', updateVisibility);
  }
  motionButton?.addEventListener('click', () => {
    const paused = motionButton.getAttribute('aria-pressed') !== 'true';
    setMotion(paused);
  });
</script>
