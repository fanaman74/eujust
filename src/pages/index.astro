---
import Layout from '../layouts/Layout.astro';
import PageGuide from '../components/PageGuide.astro';
import Icon from '../components/Icon.astro';
import CaseRow from '../components/CaseRow.astro';
import { query } from '../lib/db';
import { pageGuides } from '../data/page-guides';
let latest: any[] = [], total = 0, error = '';
try {
  latest = (await query(`SELECT c.id,c.celex,c.case_number,c.title,c.judgment_date,c.summary,co.name court, COALESCE(array_agg(DISTINCT t.name_en) FILTER (WHERE t.id IS NOT NULL),'{}') topics FROM cases c LEFT JOIN courts co ON co.id=c.court_id LEFT JOIN case_topics ct ON ct.case_id=c.id LEFT JOIN topics t ON t.id=ct.topic_id GROUP BY c.id,co.name ORDER BY c.judgment_date DESC NULLS LAST,c.id DESC LIMIT 5`)).rows;
  total = Number((await query<{ total: string }>('SELECT count(*) total FROM cases')).rows[0].total);
} catch (e) { error = e instanceof Error ? e.message : 'Database unavailable'; }
---
<Layout title="European staff rights and institutional accountability" description="Court rulings, workplace rules and institutional accountability records linked to their official sources.">
  <section class="hero home-hero">
    <picture>
      <img src="/images/home-hero.png" alt="European Union flag hanging inside a glass and steel atrium." width="1011" height="673" fetchpriority="high" />
    </picture>
    <div class="hero-block">
      <h1>European staff rights, rules and accountability</h1>
      <div>
      <p>Follow court rulings, workplace rules and institutional updates on harassment, discrimination and mental health at work, alongside wider institutional and budget accountability. Every record links to its official source.</p>
      <div class="hero-actions">
        <a class="button wire" href="#latest">Read the latest rulings</a>
        <a class="button ghost" href="/cases">Browse all{total > 0 && ` ${total}`}</a>
      </div>
      </div>
    </div>
  </section>

  <PageGuide {...pageGuides.home} />

  <section class="latest" id="latest" aria-labelledby="h-latest">
    <header class="latest-head">
      <h2 id="h-latest">Latest rulings</h2>
      <p>The five most recent decisions by judgment date.</p>
    </header>
    {error ? (
      <div class="empty" role="alert"><h3>The rulings cannot be loaded right now</h3><p>{error}</p></div>
    ) : latest.length === 0 ? (
      <div class="empty"><h3>No rulings collected yet</h3><p>Rulings appear here after the first check of the official source.</p><a class="button" href="/monitoring">Go to monitoring</a></div>
    ) : (
      <>
        <ul class="dispatches">{latest.map((item, index) => <CaseRow item={item} lead={index === 0} />)}</ul>
        <a class="view-all" href="/cases">View all {total} rulings <Icon name="arrow-right" size={28} /></a>
      </>
    )}
  </section>

  <section class="method" aria-labelledby="h-method">
    <h2 id="h-method">How to read this site</h2>
    <div class="method-points">
      <div><h3>The court’s text comes first</h3><p>Each ruling carries its case number, court and date, and a link to the official document on EUR-Lex. That document is the authority, not this site.</p></div>
      <div><h3>Summaries are labelled</h3><p>Where an AI summary exists it is marked as generated and kept apart from the official record. It is a reading aid, never a court finding.</p></div>
      <div><h3>Coverage has limits</h3><p>Rulings are found by a daily keyword search of EUR-Lex for harassment, psychosocial risk and discrimination. Some relevant decisions will be missing.</p></div>
    </div>
  </section>
</Layout>
