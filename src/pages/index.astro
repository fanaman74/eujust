---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CourtCard from '../components/CourtCard.astro';
import { query } from '../lib/db';
import { getTopicFeed, type TopicFeedItem } from '../lib/topic-feed';

let latest: any[] = [], total = 0, sourceCount = 0, lastCheck: string | null = null, error = '';
try {
  latest = (await query(`SELECT c.id,c.celex,c.case_number,c.title,c.judgment_date,c.summary,co.name court, (SELECT d.official_url FROM documents d WHERE d.case_id=c.id ORDER BY d.retrieved_at DESC NULLS LAST,d.id DESC LIMIT 1) official_url, COALESCE(array_agg(DISTINCT t.name_en) FILTER (WHERE t.id IS NOT NULL),'{}') topics FROM cases c LEFT JOIN courts co ON co.id=c.court_id LEFT JOIN case_topics ct ON ct.case_id=c.id LEFT JOIN topics t ON t.id=ct.topic_id GROUP BY c.id,co.name ORDER BY c.judgment_date DESC NULLS LAST,c.id DESC LIMIT 5`)).rows;
  total = Number((await query<{ total: string }>('SELECT count(*) total FROM cases')).rows[0].total);
  const sources = (await query<{ enabled: string; checked: string | null }>(`SELECT count(*) FILTER (WHERE enabled) enabled, max(last_checked_at) FILTER (WHERE key='eurlex-sparql') checked FROM sources`)).rows[0];
  sourceCount = Number(sources?.enabled ?? 0);
  lastCheck = sources?.checked ?? null;
} catch (e) { error = e instanceof Error ? e.message : 'Database unavailable'; }

const formatDate = (value: string | Date, options: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' }) => new Intl.DateTimeFormat('en-GB', { ...options, timeZone: 'Europe/Brussels' }).format(new Date(value));
const latestJudgment = latest.find((item) => item.judgment_date)?.judgment_date ?? null;
let feed: TopicFeedItem[] = [], feedError = false;
try { feed = await getTopicFeed(5); } catch { feedError = true; }

const ledger = [
  total > 0 && { label: 'Court rulings on record', value: String(total) },
  latestJudgment && { label: 'Most recent judgment', value: formatDate(latestJudgment) },
  lastCheck && { label: 'Court feed last checked', value: formatDate(lastCheck) },
  sourceCount > 0 && { label: 'Official feeds monitored', value: String(sourceCount) }
].filter(Boolean) as { label: string; value: string }[];
if (error || feedError) { Astro.response.status = 503; Astro.response.headers.set('Retry-After', '60'); }

---

<Layout title="EU employment law: court rulings & workplace rights" description="Find EU court rulings on workplace harassment, discrimination and psychosocial risks. Explore institutional rules and accountability, linked to official sources." noindex={Boolean(error)}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-map-media" aria-hidden="true">
      <picture><source media="(max-width: 700px)" srcset="/videos/europe-portrait-poster.png" /><img class="hero-map-poster" src="/videos/europe-landscape-poster.png" alt="" width="1920" height="1080" fetchpriority="high" /></picture>
      <video class="hero-map-video" muted loop playsinline preload="none" data-landscape="/videos/europe-landscape.mp4" data-portrait="/videos/europe-portrait.mp4" aria-label="Animated map of Europe" aria-hidden="true"></video>
      <div class="hero-map-shade"></div>
    </div>
    <div class="home-hero-copy">
      <h1 id="home-title">Workplace rights.<br /><span>Straight to the source.</span></h1>
      <p class="home-lede">Follow European court rulings on harassment, discrimination and psychosocial risk at work. Find the record, understand the context, and go straight to the official source.</p>

    </div>
    <div class="hero-map-controls">
      <button class="hero-motion icon-control" type="button" aria-label="Pause map animation" title="Pause map animation" aria-pressed="false"><span data-pause-icon><Icon name="pause" size={20} /></span><span data-play-icon hidden><Icon name="play" size={20} /></span></button>
      <button class="hero-fullscreen icon-control" type="button" aria-label="View Europe map full screen" title="View Europe map full screen"><Icon name="fullscreen" size={20} /></button>
    </div>
    <a class="hero-map-credit" href="https://www.naturalearthdata.com/">Map: Natural Earth</a>
  </section>
  <section class="wrap home-feed" aria-label="Latest research updates">
    <div class="research-window">
      <div class="research-window-bar"><span class="window-brand">EU JUST / Feed</span><span>Official source records</span></div>
      <div class="research-window-body">
        <section class="topic-feed" aria-labelledby="topic-feed-title">
          <h2 id="topic-feed-title">Latest updates.</h2>
          <p class="topic-feed-note">Recent court rulings and institutional records; topics are keyword matches.</p>
          {feedError ? <p class="topic-feed-state" role="alert">Updates cannot be loaded right now. Please try again later.</p> : !feed.length ? <p class="topic-feed-state">No topic updates collected yet. New source records will appear here after a monitoring check.</p> : (
            <div class="topic-feed-viewport"><ol class="topic-feed-list">
              {feed.map((item) => <li>
                <div class="topic-feed-meta"><span>{item.dateLabel}</span>{item.date ? <time datetime={item.date}>{formatDate(item.date)}</time> : <span>Date not recorded</span>}</div>
                <a class="topic-feed-title" href={item.href} title={item.title}><span>{item.title}</span><Icon name={item.href.startsWith('/') ? 'arrow-right' : 'external'} size={16} /></a>
                <p class="topic-feed-source">{item.source}</p>
                <p class="topic-feed-matches">{item.categories.join(' · ')}</p>
              </li>)}
            </ol></div>
          )}
          <div class="topic-feed-actions"><a href="/topics">Explore all topics <Icon name="arrow-right" size={15} /></a><div class="topic-feed-controls" hidden><button class="topic-feed-pause icon-control" type="button" aria-pressed="false" aria-label="Pause feed" title="Pause feed"><span data-pause-icon><Icon name="pause" size={18} /></span><span data-play-icon hidden><Icon name="play" size={18} /></span></button><button class="topic-feed-next icon-control" type="button" aria-label="Next update" title="Next update"><Icon name="arrow-right" size={18} /></button></div></div>
        </section>
      </div>
    </div>
  </section>

  {ledger.length > 0 && (
    <section class="wrap collection-overview" aria-labelledby="collection-title">
      <header><h2 id="collection-title">Collection overview.</h2><a href="/monitoring">View source checks <Icon name="arrow-right" size={16} /></a></header>
      <dl class="ledger">
        {ledger.map((cell) => <div><dt>{cell.label}</dt><dd>{cell.value}</dd></div>)}
      </dl>
    </section>
  )}

  <section class="wrap home-services" aria-labelledby="services-title">
    <h2 id="services-title">Four ways to explore the record.</h2>
    <div class="service-grid">
      {[
        { href: '/cases', title: 'Court rulings', icon: 'search', description: 'Find European court decisions on workplace rights, linked to the official judgment.', action: 'Find a ruling' },
        { href: '/rules', title: 'Rules & updates', icon: 'scale', description: 'Explore the rules and policies that shape working life in EU institutions.', action: 'Explore the rules' },
        { href: '/decisions', title: 'Selected records', icon: 'book', description: 'Read selected judgments, reports and oversight records.', action: 'Browse the selection' },
        { href: '/discharge', title: 'Budget discharge', icon: 'activity', description: 'Follow how Parliament scrutinises spending by EU institutions.', action: 'Follow accountability' }
      ].map((service) => (
        <a class="service-card" href={service.href}>
          <Icon name={service.icon} size={28} />
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <span class="service-card-action">{service.action}<Icon name="arrow-right" size={17} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-latest latest-courts" id="latest" aria-labelledby="home-latest-title">
    <div class="latest-scan-stage" aria-hidden="true"><div class="latest-sonar"></div></div>
    <div class="latest-wave-edge" aria-hidden="true">
      <svg class="latest-wave" viewBox="0 0 2880 74" preserveAspectRatio="none"><path d="M0 46 C171 46 209 30 380 30 C533 30 567 50 720 50 C873 50 907 36 1060 36 C1231 36 1269 46 1440 46 C1611 46 1649 30 1820 30 C1973 30 2007 50 2160 50 C2313 50 2347 36 2500 36 C2671 36 2709 46 2880 46 L2880 74 L0 74 Z" /></svg>
    </div>
    <div class="wrap latest-layout">
      <header class="latest-intro">
        <h2 id="home-latest-title">The latest<br />from the courts.</h2>
        <p>Newest first, by judgment date. Read the case record, follow its matched topics, and open the official source.</p>
        {!error && latest.length > 0 && <p class="latest-coverage">{latest.length} latest collected rulings · keyword-based coverage</p>}
        <a class="latest-archive-link" href="/cases">Search all {total > 0 ? `${total} rulings` : 'rulings'} <Icon name="arrow-right" size={17} /></a>
        <div class="latest-motion-controls">
          <button class="latest-motion" type="button" aria-pressed="false">Pause section animation</button>
          {latest.length > 0 && <button class="latest-replay" type="button">Replay card highlight</button>}
        </div>
      </header>
      {error ? (
        <div class="latest-empty" role="alert"><h3>The rulings cannot be loaded right now</h3><p>{error}</p></div>
      ) : latest.length === 0 ? (
        <div class="latest-empty"><h3>No rulings collected yet</h3><p>Rulings appear here after the first check of the official source.</p><a href="/monitoring">Go to monitoring <Icon name="arrow-right" /></a></div>
      ) : (
        <ul class="court-card-grid" aria-label="Latest court rulings">
          {latest.map((item) => <CourtCard item={item} />)}
          <li class="court-card court-card-archive">
            <div class="court-card-content">
            <Icon name="search" size={28} />
            <h3><a href="/cases">Keep exploring.</a></h3>
            <p>Search all {total} collected rulings by party, case number, court or matched topic.</p>
            <a class="court-card-action" href="/cases">Browse the collection <Icon name="arrow-right" size={16} /></a>
            </div>
          </li>
        </ul>
      )}
    </div>
  </section>

  <section class="wrap home-method" aria-labelledby="home-method-title">
    <header class="section-head">
      <div>
        <h2 id="home-method-title">An informed reading starts here.</h2>
      </div>
    </header>
    <dl class="method-grid">
      <div>
        <dt>The official text is the authority</dt>
        <dd>Case records link to EUR-Lex. Other items link to the institution that published them. Titles are shown as published.</dd>
      </div>
      <div>
        <dt>Summaries are labelled</dt>
        <dd>AI summaries are optional, marked as generated and kept apart from the official record. They are a reading aid, never a court finding.</dd>
      </div>
      <div>
        <dt>The collection has limits</dt>
        <dd>Rulings are found by keyword searches over a bounded window, and topics are keyword matches rather than legal analysis. Relevant material may be missing.</dd>
      </div>
    </dl>
  </section>
</Layout>

<script>
  import '../scripts/latest-courts';
  import '../scripts/topic-feed';
  import '../scripts/hero-map';
</script>
