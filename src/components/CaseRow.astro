---
import Icon from './Icon.astro';
import { parseTitle } from '../lib/title';
const { item, lead = false } = Astro.props;
const parsed = parseTitle(item.title);
const judged = item.judgment_date ? new Date(item.judgment_date) : null;
const part = (options: Intl.DateTimeFormatOptions) => judged ? new Intl.DateTimeFormat('en-GB', options).format(judged) : '';
const topics: string[] = item.topics ?? [];
---
<li class:list={['dispatch', { lead }]}>
  <p class="dispatch-date">
    {judged ? <time datetime={judged.toISOString().slice(0, 10)}><span>{part({ day: 'numeric', month: 'short' })}</span> {part({ year: 'numeric' })}</time> : <span class="undated">Undated</span>}
  </p>
  <div class="dispatch-body">
    <h3><a href={`/cases/${item.id}`}>{parsed.heading}</a></h3>
    {parsed.keywords.length > 0 ? <p class="dispatch-subject">{parsed.keywords.join(' · ')}</p> : parsed.formation && <p class="dispatch-subject">{parsed.formation}</p>}
    {item.summary && <p class="dispatch-summary"><span class="badge ai">AI summary</span> {item.summary}</p>}
    {topics.length > 0 && <ul class="tags" aria-label="Topics">{topics.map((tag) => <li class="tag">{tag}</li>)}</ul>}
  </div>
  <p class="dispatch-ref"><strong>{item.case_number ?? item.celex}</strong><span>{item.court ?? 'Court not recorded'}</span><Icon name="arrow-right" size={20} /></p>
</li>
