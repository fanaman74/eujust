---
import type { Breadcrumb } from '../lib/seo';
interface Props { items: Breadcrumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>{items.map((item, index) => <li>{index === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}</li>)}</ol>
</nav>
