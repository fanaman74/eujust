---
import '../styles/global.css';
import { query } from '../lib/db';
import Icon from '../components/Icon.astro';
import { canonicalUrl, isIndexable, jsonLd, pageStructuredData, type Breadcrumb, type StructuredData } from '../lib/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  canonicalPath?: string;
  canonicalPage?: number;
  pageType?: string;
  breadcrumbs?: Breadcrumb[];
  mainEntity?: StructuredData;
}
const { title = 'EU JUST', description = 'European staff rights, institutional rules and accountability records linked to their official sources.', noindex = false, canonicalPath, canonicalPage = 1, pageType = 'WebPage', breadcrumbs = [], mainEntity } = Astro.props;
const fullTitle = title === 'EU JUST' ? 'EU JUST — European workplace law & official court records' : `${title} · EU JUST`;
const canonical = canonicalUrl(canonicalPath ?? Astro.url.pathname, canonicalPage);
const indexable = isIndexable(Astro.url, Astro.response.status ?? 200, noindex);
const sharingImage = canonicalUrl('/social-card.png');
const structuredData = indexable ? pageStructuredData(fullTitle, description, canonical, pageType, breadcrumbs, mainEntity) : null;
const path = Astro.url.pathname;
const researchLinks = [
  { href: '/cases', label: 'Court rulings', note: 'Daily feed from EUR-Lex', active: path.startsWith('/cases') },
  { href: '/rules', label: 'Rules & updates', note: 'Ombudsman, Commission, staff rules', active: path.startsWith('/rules') },
  { href: '/decisions', label: 'Selected records', note: 'Editorial selection', active: path.startsWith('/decisions') },
  { href: '/discharge', label: 'Budget discharge', note: 'Parliament’s scrutiny cycle', active: path.startsWith('/discharge') }
];
const operationalLinks = [
  { href: '/monitoring', label: 'Monitoring', note: 'Source checks and schedule', active: path.startsWith('/monitoring') },
  { href: '/settings', label: 'AI settings', note: 'Summary providers', active: path.startsWith('/settings') }
];
const officialSources = [
  { href: 'https://eur-lex.europa.eu/', label: 'EUR-Lex' },
  { href: 'https://www.ombudsman.europa.eu/', label: 'European Ombudsman' },
  { href: 'https://ec.europa.eu/commission/presscorner/', label: 'Commission Press Corner' },
  { href: 'https://www.europarl.europa.eu/committees/en/cont/discharge-procedure/discharge-2024', label: 'Parliament discharge file' }
];
let lastCheck: string | null = null;
try { lastCheck = (await query<{ last_checked_at: string | null }>("SELECT last_checked_at FROM sources WHERE key='eurlex-sparql'")).rows[0]?.last_checked_at ?? null; } catch { /* the bar simply omits the check time when the database is unreachable */ }
const checked = lastCheck ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Brussels' }).format(new Date(lastCheck)) : null;
const operationsCurrent = operationalLinks.some((link) => link.active);
const surface = path === '/' ? 'home' : path === '/monitoring' || path === '/settings' ? 'operations' : /^\/cases\/.+/.test(path) ? 'record' : 'research';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fcfff7" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EU JUST" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={sharingImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="EU JUST — European workplace law, traced to the official source." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={sharingImage} />
    <meta name="twitter:image:alt" content="EU JUST — European workplace law, traced to the official source." />
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
  </head>
  <body data-surface={surface}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href="/" aria-label="EU JUST, home"><span class="wordmark-eu" aria-hidden="true">EU</span><span class="wordmark-just" aria-hidden="true">JUST</span></a>
        <nav class="primary-nav" aria-label="Primary">
          {researchLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <div class="masthead-tools">
          {checked && <p class="masthead-check" title="Last attempted check of the court feed">Court feed checked <time datetime={lastCheck!}>{checked}</time></p>}
          <details class:list={['nav-dropdown', { 'is-current': operationsCurrent }]}>
            <summary aria-current={operationsCurrent ? 'location' : undefined}>Operations <Icon name="chevron-down" size={16} /></summary>
            <div class="nav-menu">
              {operationalLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}<small>{link.note}</small></a>)}
            </div>
          </details>
          <a class="button nav-search" href="/cases">Find a ruling <Icon name="arrow-right" size={15} /></a>
        </div>
        <details class="mobile-menu">
          <summary>Menu <Icon name="chevron-down" size={16} /></summary>
          <nav class="nav-menu" aria-label="Site">
            <p class="nav-menu-label">Research</p>
            {researchLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}<small>{link.note}</small></a>)}
            <p class="nav-menu-label">Operations</p>
            {operationalLinks.map((link) => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}<small>{link.note}</small></a>)}
            {checked && <p class="masthead-check">Court feed checked <time datetime={lastCheck!}>{checked}</time></p>}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="colophon">
      <div class="colophon-inner">
        <div class="colophon-brand">
          <a class="wordmark" href="/" aria-label="EU JUST, home"><span class="wordmark-eu" aria-hidden="true">EU</span><span class="wordmark-just" aria-hidden="true">JUST</span></a>
          <p>Research support only, not legal advice. Verify each ruling, policy or report against its linked official document and publishing authority. Court records come from daily keyword searches, so coverage is not exhaustive.</p>
        </div>
        <nav aria-labelledby="footer-research">
          <h2 id="footer-research">Research</h2>
          <ul><li><a href="/topics">Research topics</a></li>{researchLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
        <nav aria-labelledby="footer-operations">
          <h2 id="footer-operations">Operations</h2>
          <ul>{operationalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
        <nav aria-labelledby="footer-sources">
          <h2 id="footer-sources">Official sources</h2>
          <ul>{officialSources.map((link) => <li><a href={link.href} target="_blank" rel="noreferrer">{link.label}<Icon name="external" size={13} /><span class="sr-only"> (opens in a new tab)</span></a></li>)}</ul>
        </nav>
      </div>
      <div class="colophon-lockup" aria-hidden="true">EU JUST<span>Closer to the source.</span></div>
      <div class="colophon-base"><p>The linked official document is always the authority. AI summaries, where present, are labelled as generated.</p></div>
    </footer>
    <script>
      // Close open header menus on an outside click or Escape, so the disclosure menus behave like menus.
      const menus = () => [...document.querySelectorAll<HTMLDetailsElement>('.masthead details[open]')];
      document.addEventListener('click', (event) => {
        for (const menu of menus()) if (!menu.contains(event.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const menu of menus()) { menu.open = false; menu.querySelector('summary')?.focus(); }
      });
    </script>
  </body>
</html>
